; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="A Spade's A Spade"
config/description="ASAS - a 3D voxel deckbuilder where the spade is the core implement."
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/stretch/mode="canvas_items"

[autoload]

Sfx="*res://scripts/audio.gd"

[gui]

theme/custom="res://assets/ui_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.45, 0.72, 0.95, 1)
